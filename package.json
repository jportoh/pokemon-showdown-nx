{
  "name": "pokemon-showdown-nx",
  "version": "0.6.2",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:nro": "ng build && node scripts/build-nro.mjs",
    "build:nro:probe": "node scripts/build-nro.mjs --probe",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "update:calc-sets": "node scripts/update-calc-sets.mjs",
    "update:champions": "node scripts/update-champions-data.mjs",
    "update:moves": "node scripts/update-moves.mjs",
    "update:names": "node scripts/update-names.mjs",
    "update:species": "node scripts/update-species.mjs",
    "update:past-gens": "node scripts/update-past-gens.mjs",
    "update:battle-music": "node scripts/update-battle-music.mjs",
    "update:soundtracks": "node scripts/update-soundtracks.mjs",
    "update:sprites": "node scripts/update-sprite-sheets.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@smogon/calc": "^0.12.0",
    "fflate": "^0.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@tootallnate/nacp": "^0.2.1",
    "@tootallnate/nro": "^0.1.3",
    "@tootallnate/romfs": "^0.1.1",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
